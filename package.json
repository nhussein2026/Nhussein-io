{
  "name": "nhussein-io",
  "version": "2.0.0-alpha.1",
  "description": "Personal site of Nasser Hussein, software engineer and Computer Engineering M.Sc. student at İTÜ.",
  "author": "Nasser Hussein <nhussein2026@gmail.com>",
  "homepage": "https://nhussein.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/nhussein2026/Nhussein-io.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "portfolio",
    "astro",
    "nasser-hussein",
    "software-engineer"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "fetch-data": "bun scripts/fetch-repos.mjs && bun scripts/fetch-contributions.mjs",
    "prebuild": "bun run fetch-data",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "linkinator dist --recurse --skip \"^(https?:|mailto:)(?!//(localhost|127\\.0\\.0\\.1))\"",
    "check:version": "bun scripts/check-version.mjs",
    "format": "prettier --write .",
    "check:content": "bun scripts/check-content.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.1",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3"
  }
}

---
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"journey">[];
}
const { items } = Astro.props;

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const label = (d: string) => {
  const [y, m] = d.split("-");
  return m ? `${months[Number(m) - 1]} ${y}` : y;
};
const kindLabel = { study: "Study", work: "Work", project: "Project", community: "Community" };
---

<!-- A date column beside the text, as on a CV. On phones the date sits above. -->
<ol class="divide-y divide-line border-y border-line">
  {items.map(({ data }) => (
    <li class="grid gap-x-6 py-4 sm:grid-cols-[7.5rem_1fr]">
      <p class="text-sm text-muted sm:pt-0.5">
        <time datetime={data.date} class="tabular">
          {label(data.date)}
        </time>
        <span class="sr-only">, {kindLabel[data.kind]}</span>
      </p>
      <div>
        <h3 class="text-base font-semibold">
          {data.link ? <a href={data.link}>{data.title}</a> : data.title}
        </h3>
        <p class="max-w-measure text-muted">{data.line}</p>
      </div>
    </li>
  ))}
</ol>

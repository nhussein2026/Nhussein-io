---
import { profile } from "../data/profile";
import { version, releaseUrl } from "../data/site";
---

<footer class="border-t border-line text-[0.9rem] text-muted">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-3 px-4 py-8 sm:flex-row sm:items-baseline sm:justify-between sm:px-6">
    <p>Built by {profile.name}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      <li>
        <a href={`mailto:${profile.email}`}>Email</a>
      </li>
      <li>
        <a href={profile.links.github}>GitHub</a>
      </li>
      <li>
        <a href={profile.links.linkedin}>LinkedIn</a>
      </li>
      <li>
        <a href={profile.links.source}>Source</a>
      </li>
      <li>
        <a href={releaseUrl} class="font-mono text-[0.85em]">
          v{version}
        </a>
      </li>
    </ul>
  </div>
</footer>

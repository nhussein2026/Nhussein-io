---
import { profile } from "../data/profile";
import { version, releaseUrl } from "../data/site";
---

<footer class="border-t border-line text-sm text-muted">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-3 px-4 py-8 sm:flex-row sm:items-baseline sm:justify-between sm:px-6">
    <p>Built by {profile.name}</p>
    <ul class="link-list flex flex-wrap gap-x-5">
      <li>
        <a href={`mailto:${profile.email}`}>Email</a>
      </li>
      <li>
        <a href={profile.links.github} target="_blank" rel="me noopener">
          GitHub<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a href={profile.links.linkedin} target="_blank" rel="me noopener">
          LinkedIn<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a href={profile.links.source} target="_blank" rel="noopener">Source</a>
      </li>
      <li>
        <a href={releaseUrl} class="tabular" target="_blank" rel="noopener">
          v{version}
        </a>
      </li>
    </ul>
  </div>
</footer>

---
import type { CollectionEntry } from "astro:content";
import Tag from "./Tag.astro";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: "h2" | "h3";
}
const { project, headingLevel = "h3" } = Astro.props;
const { title, summary, status, stack } = project.data;
const Heading = headingLevel;
---

<article class="group relative rounded-lg border border-line p-5 transition-colors hover:border-accent focus-within:border-accent">
  <Heading class="text-lg">
    <a href={`/work/${project.id}/`} class="text-text no-underline after:absolute after:inset-0">
      {title}
    </a>
  </Heading>
  <p class="mt-1">{summary}</p>
  <p class="mt-3 text-[0.9rem] text-muted">{status}</p>
  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Built with">
    {stack.map((s) => (
      <li>
        <Tag>{s}</Tag>
      </li>
    ))}
  </ul>
</article>

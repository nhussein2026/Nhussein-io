---
import { nav } from "../data/site";
import { profile } from "../data/profile";

// Links end with a slash (trailingSlash: "always"); compare without it.
const strip = (p: string) => p.replace(/\/$/, "") || "/";
const path = strip(Astro.url.pathname);
const isCurrent = (href: string) => path === strip(href) || path.startsWith(href);
---

<header class="border-b border-line">
  <nav
    aria-label="Main"
    class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-2 sm:px-6"
  >
    <!-- py-2.5 keeps every link at least 24px tall (WCAG 2.2, 2.5.8 target size). -->
    <a href="/" class="inline-block py-2.5 font-semibold text-text no-underline hover:text-accent">
      {profile.name}
    </a>
    <ul class="flex gap-5 text-[0.95rem]">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={[
              "inline-block py-2.5 no-underline hover:underline",
              isCurrent(item.href) ? "text-text font-medium underline" : "text-muted",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

---
import { nav } from "../data/site";
import { profile } from "../data/profile";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-b border-line">
  <nav
    aria-label="Main"
    class="mx-auto flex w-full max-w-3xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-4 py-4 sm:px-6"
  >
    <a href="/" class="font-semibold text-text no-underline hover:text-accent">
      {profile.name}
    </a>
    <ul class="flex gap-5 text-[0.95rem]">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={[
              "no-underline hover:underline",
              isCurrent(item.href) ? "text-text font-medium underline" : "text-muted",
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

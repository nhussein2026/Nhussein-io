---
import { nav } from "../data/site";
import { profile } from "../data/profile";

// Links end with a slash (trailingSlash: "always"); compare without it.
const strip = (p: string) => p.replace(/\/$/, "") || "/";
const path = strip(Astro.url.pathname);
const isCurrent = (href: string) => path === strip(href) || path.startsWith(href);
---

<header class="border-b border-line">
  <nav
    aria-label="Main"
    class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-x-6 px-4 sm:px-6"
  >
    <!-- py-3 makes each link at least 44px tall: well over the 24px of WCAG 2.2, 2.5.8. -->
    <a
      href="/"
      class="inline-block py-3 font-semibold text-text no-underline hover:text-accent-text"
    >
      {profile.name}
    </a>
    <ul class="flex gap-5">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class="inline-block py-3 text-muted no-underline decoration-2 underline-offset-[0.35em] hover:text-text hover:underline aria-[current=page]:text-text aria-[current=page]:underline"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile } from "../data/profile";

interface Props {
  title: string;
  description: string;
  /** Adds the schema.org Person block. Used on Home and About. */
  person?: boolean;
  /** Absolute or root-relative path to the preview image. */
  image?: string;
  /** For the not-found page: no canonical link, and search engines skip it. */
  noindex?: boolean;
}

const {
  title,
  description,
  person = false,
  image = "/og-image.png",
  noindex = false,
} = Astro.props;
const fullTitle =
  title === profile.name ? `${profile.name} · Software Engineer` : `${title} · ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: "https://nhussein.io",
  jobTitle: "Software Engineer",
  description: profile.headline,
  email: `mailto:${profile.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Istanbul", addressCountry: "TR" },
  worksFor: { "@type": "Organization", name: "Veribir Technology Services Ltd" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "İstanbul Nişantaşı Üniversitesi" },
  affiliation: { "@type": "CollegeOrUniversity", name: "İstanbul Teknik Üniversitesi" },
  knowsLanguage: ["ar", "en", "tr"],
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f9fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111419" media="(prefers-color-scheme: dark)" />
    <meta name="author" content={profile.name} />

    <meta property="og:type" content={person ? "profile" : "website"} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}: ${profile.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {person && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
  </head>
  <body class="bg-bg text-text antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-10 focus:bg-bg focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-4 pt-10 pb-20 sm:px-6 sm:pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>

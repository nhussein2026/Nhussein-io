---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---

<Base title="Page not found" description="This page does not exist on nhussein.io." noindex>
  <!-- Centred in the space between header and footer. -->
  <div class="flex min-h-[55dvh] flex-col items-center justify-center text-center">
    <p class="tabular text-sm text-muted">404</p>
    <h1 class="mt-2 text-3xl sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-measure text-muted">
      There is nothing at this address. It may have moved when the site was rebuilt.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-3">
      <Button href="/">Home</Button>
      <ul class="link-list flex gap-x-6">
        <li>
          <a href="/work/">Work</a>
        </li>
        <li>
          <a href="/journey/">Journey</a>
        </li>
      </ul>
    </div>
  </div>
</Base>

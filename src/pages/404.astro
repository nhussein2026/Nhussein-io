---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist on nhussein.io." noindex>
  <h1 class="text-2xl">Page not found</h1>
  <p class="mt-3 max-w-measure text-muted">
    There is nothing at this address. It may have moved when the site was rebuilt.
  </p>
  <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
    <li>
      <a href="/">Home</a>
    </li>
    <li>
      <a href="/work/">Work</a>
    </li>
    <li>
      <a href="/journey/">Journey</a>
    </li>
  </ul>
</Base>

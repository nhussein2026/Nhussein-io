---
import Base from "../layouts/Base.astro";
import SkillList from "../components/SkillList.astro";
import Button from "../components/Button.astro";
import { profile, experience, education, languages } from "../data/profile";
---

<Base
  title="About"
  description="About Nasser Hussein: software engineer at Veribir and Computer Engineering M.Sc. student at İTÜ, in Istanbul. Experience, education, languages, skills and contact."
  person
>
  <h1 class="text-2xl">About</h1>

  <div class="prose mt-6">
    <!-- Matches the LinkedIn About word for word. Change both together. -->
    <p>
      I'm a software engineer. I care about understanding how things work and building them
      properly, so they keep working long after launch.
    </p>
    <p>
      At Veribir I'm part of a team that puts industrial manufacturers' product data online,
      straight from their existing databases. We build every website on one standard CMS structure
      and a clean stack. My part runs from the interface to the backend. We use MCP, Claude and
      Claude Code skills in our daily work.
    </p>
    <p>
      Outside work I build my own tools, mostly in TypeScript with React, Astro and Node.js. Hop,
      the planning app I use every day, is one of them: I designed it, wrote the specs and release
      rules, and built it with Claude Code, reviewing and testing every change. That is how I like
      to use AI, as part of careful engineering.
    </p>
    <p>
      I'm an M.Sc. student in Computer Engineering at İTÜ, going deeper into the foundations and
      into machine learning. I'm from Yemen, live in Istanbul, and work in Arabic and English while
      I learn Turkish.
    </p>
    <p>
      I'm open to part-time roles, internships, remote work and research projects at İTÜ, anywhere I
      can take real responsibility and keep learning. You can see my work at{" "}
      <a href={profile.links.github} target="_blank" rel="me noopener">
        github.com/nhussein2026<span class="sr-only"> (opens in a new tab)</span>
      </a>
      , and I'm always glad to talk.
    </p>
  </div>

  <section aria-labelledby="experience" class="mt-14">
    <h2 id="experience" class="text-xl">
      Experience
    </h2>
    <ol class="mt-5 space-y-8">
      {experience.map((e) => (
        <li>
          <h3 class="text-base font-semibold">
            {e.title} · {e.org}
          </h3>
          <p class="tabular text-sm text-muted">
            {e.start} – {e.end} · {e.terms}
          </p>
          <ul class="mt-2 max-w-measure list-disc space-y-1 pl-5 marker:text-muted">
            {e.lines.map((l) => (
              <li>{l}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="education" class="mt-14">
    <h2 id="education" class="text-xl">
      Education
    </h2>
    <ol class="mt-5 space-y-6">
      {education.map((e) => (
        <li>
          <h3 class="text-base font-semibold">{e.degree}</h3>
          <p>{e.school}</p>
          <p class="tabular text-sm text-muted">
            {e.start} – {e.end} · {e.line}
          </p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="languages" class="mt-14">
    <h2 id="languages" class="text-xl">
      Languages
    </h2>
    <ul class="mt-4 space-y-1">
      {languages.map((l) => (
        <li>
          <span class="font-medium">{l.name}</span>
          <span class="text-muted"> · {l.level}</span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="skills" class="mt-14">
    <h2 id="skills" class="text-xl">
      Skills, with where I used them
    </h2>
    <div class="mt-5">
      <SkillList />
    </div>
  </section>

  <section aria-labelledby="contact" class="mt-14 border-t border-line pt-10">
    <h2 id="contact" class="text-xl">
      Contact
    </h2>
    <p class="mt-2 max-w-measure">{profile.openTo}</p>
    <p class="mt-2">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <Button href={profile.cv} download>
        Download CV (PDF)
      </Button>
      <Button href={profile.links.linkedin} variant="plain" newTab>
        LinkedIn
      </Button>
      <Button href={profile.links.github} variant="plain" newTab>
        GitHub
      </Button>
    </div>
  </section>
</Base>

---
import Base from "../layouts/Base.astro";
import SkillList from "../components/SkillList.astro";
import Button from "../components/Button.astro";
import { profile, experience, education, languages } from "../data/profile";
---

<Base
  title="About"
  description="About Nasser Hussein: software engineer at Veribir and Computer Engineering M.Sc. student at İTÜ, in Istanbul. Experience, education, languages, skills and contact."
  person
>
  <h1 class="text-2xl">About</h1>

  <div class="prose mt-6">
    <!-- Same facts as the LinkedIn About, written for this page: what the sections below
         already say (experience, languages, contact) is not repeated here. -->
    <p>
      I'm a software engineer in Istanbul. I care about understanding how things work and building
      them properly, so they keep working long after launch.
    </p>
    <p>
      Right now my week is split between work and study. At Veribir I work part-time in a team that
      puts industrial manufacturers' product data online, straight from their existing databases,
      and my part runs from the interface to the backend. At İTÜ I'm doing an M.Sc. in Computer
      Engineering, going deeper into the foundations and into machine learning.
    </p>
    <p>
      Outside work and study, I build my own tools. The one I use every day is Hop, a planning app I
      designed, specified and built with Claude Code, reviewing and testing every change. That is
      how I like to use AI: as part of careful engineering.
    </p>
    <p>I'm from Yemen. I work in Arabic and English, and I'm learning Turkish.</p>
  </div>

  <section aria-labelledby="experience" class="mt-14">
    <h2 id="experience" class="text-xl">
      Experience
    </h2>
    <ol class="mt-5 space-y-8">
      {experience.map((e) => (
        <li>
          <h3 class="text-base font-semibold">
            {e.title} · {e.org}
          </h3>
          <p class="tabular text-sm text-muted">
            {e.start} – {e.end} · {e.terms}
          </p>
          <ul class="mt-2 max-w-measure list-disc space-y-1 pl-5 marker:text-muted">
            {e.lines.map((l) => (
              <li>{l}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="education" class="mt-14">
    <h2 id="education" class="text-xl">
      Education
    </h2>
    <ol class="mt-5 space-y-6">
      {education.map((e) => (
        <li>
          <h3 class="text-base font-semibold">{e.degree}</h3>
          <p>{e.school}</p>
          <p class="tabular text-sm text-muted">
            {e.start} – {e.end} · {e.line}
          </p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="languages" class="mt-14">
    <h2 id="languages" class="text-xl">
      Languages
    </h2>
    <ul class="mt-4 space-y-1">
      {languages.map((l) => (
        <li>
          <span class="font-medium">{l.name}</span>
          <span class="text-muted"> · {l.level}</span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="skills" class="mt-14">
    <h2 id="skills" class="text-xl">
      Skills, with where I used them
    </h2>
    <div class="mt-5">
      <SkillList />
    </div>
  </section>

  <section aria-labelledby="contact" class="mt-14 border-t border-line pt-10">
    <h2 id="contact" class="text-xl">
      Contact
    </h2>
    <p class="mt-2 max-w-measure">{profile.openTo}</p>
    <p class="mt-2">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <Button href={profile.cv} download>
        Download CV (PDF)
      </Button>
      <Button href={profile.links.linkedin} variant="plain" newTab>
        LinkedIn
      </Button>
      <Button href={profile.links.github} variant="plain" newTab>
        GitHub
      </Button>
    </div>
  </section>
</Base>
